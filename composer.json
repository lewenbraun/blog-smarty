{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "lewenbraun/blog-smarty",
    "description": "A framework-free blog built with PHP, MySQL, and Smarty.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": "^8.5",
        "ext-pdo": "*",
        "doctrine/migrations": "^3.9",
        "doctrine/orm": "^3.7",
        "smarty/smarty": "^5.8",
        "symfony/cache": "^8.1"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "fakerphp/faker": "^1.24",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-strict-rules": "^2.0",
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse": "phpstan analyse --memory-limit=512M",
        "lint": "php-cs-fixer check --diff --verbose",
        "lint:fix": "php-cs-fixer fix --verbose",
        "test": "phpunit",
        "test:unit": "phpunit --testsuite=Unit",
        "test:integration": "phpunit --testsuite=Integration",
        "quality": [
            "composer validate --strict",
            "@lint",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    }
}
